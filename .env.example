# Next.js carrega .env automaticamente (build e runtime) — diferente do backend, que não lê esse
# arquivo (ver .env.example de cliente-facil-java).

# URL do backend usada pelos Route Handlers do servidor (api/login, api/proxy/[...path], etc — todo
# fetch que roda no lado do servidor, nunca exposto ao navegador). Dentro do docker-compose, aponta
# pro nome do serviço na rede interna; rodando o front fora do Docker, aponta pro localhost.
API_URL="http://backend:8080/api/v1"

# URL do endpoint de WebSocket (STOMP), usada no navegador (StompProvider) — precisa do prefixo
# NEXT_PUBLIC_ porque é lida no cliente, não só no servidor.
NEXT_PUBLIC_WS_URL="ws://localhost:8080/ws"

# Referenciada em src/shared/utils/http.util.ts, mas hoje só alimenta uma instância do axios que
# nenhum código chama de verdade (o client HTTP real do app usa fetch nativo contra /api/proxy/*,
# ver docs/product/1_roadmap.md — "Dependência do axios sem uso real"). Deixe vazia/não configure até
# esse dead code ser removido; documentado aqui só pra não aparecer como env var "misteriosa".
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"
